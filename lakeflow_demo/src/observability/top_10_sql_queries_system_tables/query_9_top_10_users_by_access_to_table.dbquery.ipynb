   "source": [
    "-- Top 10 users by access to table\n",
    "\n",
    "SELECT\n",
    "    COUNT(*),\n",
    "    user_identity.email\n",
    "FROM\n",
    "    system.access.audit\n",
    "WHERE\n",
    "    action_name IN ('commandSubmit', 'getTable')\n",
    "    AND request_params.full_name_arg = 'catalog.schema.table'\n",
    "GROUP BY user_identity.email\n",
    "ORDER BY COUNT(*) DESC\n",
    "LIMIT 10"
   ]
  }
 ],
