# COMMAND ----------

spark.sql("USE CATALOG `default_catalog`")
spark.sql("USE SCHEMA `default`")

# COMMAND ----------

from pyspark.sql import Row

data = [Row(id=1, name="Alice"), Row(id=2, name="Bob"), Row(id=3, name="Charlie")]
df = spark.createDataFrame(data)

table_name = "default_catalog.default.users"
df.write.format("delta").mode("overwrite").saveAsTable(table_name)

# COMMAND ----------

# MAGIC %sql
# MAGIC ALTER TABLE default_catalog.default.users SET TBLPROPERTIES (delta.enableChangeDataFeed=true)

# COMMAND ----------

from pyspark.sql.functions import col

# Assume new_records_df is a DataFrame containing the new records to insert
new_records_df = spark.createDataFrame([
    (4, "David"),
    (5, "Eve")
], ["id", "name"])

target_table = "default_catalog.default.users"

# Perform merge to insert only new records (by id)
(
    spark.table(target_table)
    .alias("target")
    .merge(
        new_records_df.alias("source"),
        "target.id = source.id"
    )
    .whenNotMatchedInsertAll()
    .execute()
)